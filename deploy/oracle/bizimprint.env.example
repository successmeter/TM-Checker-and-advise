# BizImprint server settings. setup.sh copies this to /etc/bizimprint.env (readable only by root and the app).
# Edit with:  sudo nano /etc/bizimprint.env   then:  sudo systemctl restart bizimprint
# One setting per line, comments on their own lines (systemd doesn't allow comments after a value).
# Never commit real values.

# --- The site (setup.sh fills these in) ----------------------------------------------------------------------
TM_PUBLIC_URL=https://example.com.au
# Signs the private report links. Keep it the same, or old links stop working.
TM_SECRET=

# --- IP Australia: production credentials from the IP Australia developer portal -----------------------------
TM_REGISTER=ipaustralia
IPA_CLIENT_ID=
IPA_CLIENT_SECRET=
# Leave IPA_BASE_URL unset for the production register.

# --- Claude: plain-English explanations and the distinctiveness check -----------------------------------------
ANTHROPIC_API_KEY=

# --- Stripe: test keys (sk_test_...) first, live keys (sk_live_...) at launch ---------------------------------
STRIPE_SECRET_KEY=
# whsec_... from the webhook endpoint you add in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# TM_REPORT_PRICE_CENTS=29900

# --- Email (Resend). Keep the quotes. --------------------------------------------------------------------------
RESEND_API_KEY=
TM_EMAIL_FROM="BizImprint <reports@example.com.au>"

# --- Options ---------------------------------------------------------------------------------------------------
# Hold each report for your approval before it is emailed:
# TM_REVIEW_REPORTS=1
# Testing only, shows everything free with no order form:
# TM_FREE_FULL=1

# Headless Chromium for PDF reports (installed by setup.sh)
PLAYWRIGHT_BROWSERS_PATH=/opt/bizimprint/browsers
